
#include <iostream>
#include <vector>
using namespace std;

int main()
{
    vector<int> numbers;

    // Insert elements
    numbers.push_back(10);
    numbers.push_back(20);
    numbers.push_back(30);
    numbers.push_back(40);

    cout << "Vector elements: ";
    for (int n : numbers)
    {
        cout << n << " ";
    }

    // Access an element
    cout << "\nElement at index 2: " << numbers[2];

    // Remove the last element
    numbers.pop_back();

    cout << "\nAfter removing last element: ";
    for (int n : numbers)
    {
        cout << n << " ";
    }

    // Display size
    cout << "\nSize of vector: " << numbers.size();

    return 0;
}
