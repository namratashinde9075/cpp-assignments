
#include <iostream>
#include <list>
using namespace std;

int main()
{
    list<int> numbers;

    // Insert elements
    numbers.push_back(10);
    numbers.push_back(20);
    numbers.push_back(30);
    numbers.push_front(5);

    cout << "List elements: ";
    for (int n : numbers)
    {
        cout << n << " ";
    }

    // Remove an element
    numbers.remove(20);

    cout << "\nAfter removing 20: ";
    for (int n : numbers)
    {
        cout << n << " ";
    }

    // Display size
    cout << "\nSize of list: " << numbers.size();

    return 0;
}
